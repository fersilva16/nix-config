# noctalia's Ink scheme (./noctalia.nix) and the login greeter
# (modules/linux/noctalia-greeter.nix) so the two can't drift apart.
{
  black = "#0a0a0a";
  raised = "#161616";
  bone = "#e8e2d4";
  ash = "#bdb6a6";
  stone = "#8f8a80";
  slate = "#3a3833";
  red = "#b23a2e";
}
