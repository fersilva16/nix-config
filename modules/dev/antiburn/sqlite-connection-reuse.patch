+/// Read-only connections to each agent database, reused across queries.
+///
+/// Every query here used to call `Connection::open_with_flags`, so a scan
+/// opened one connection per session per accessor. Against a multi-GB
+/// `opencode.db` that means a cold page cache on every query plus a fresh
+/// read of the WAL index, and the concurrent opens then contend on the
+/// wal-index locks.
+///
+/// The pool is capped rather than kept per-thread: `spawn_blocking` can grow
+/// to hundreds of threads, and a thread-local connection would hold a handle
+/// open on every one of them, so the steady-state handle count would end up
+/// higher than the per-query opens it replaced.
+///
+/// `SQLITE_OPEN_NO_MUTEX` means SQLite does no internal locking, so a
+/// connection must never be used concurrently. Checking one out of the pool
+/// gives the caller exclusive ownership for the duration, and the mutex
+/// supplies the happens-before edge when it moves between threads.
+static DB_POOL: OnceLock<Mutex<HashMap<PathBuf, Vec<Connection>>>> = OnceLock::new();
+
+/// Deep enough to keep the blocking pool fed, shallow enough to stay bounded.
+const MAX_POOLED_CONNS: usize = 4;
+
+fn db_pool() -> &'static Mutex<HashMap<PathBuf, Vec<Connection>>> {
+    DB_POOL.get_or_init(|| Mutex::new(HashMap::new()))
+}
+
+/// A connection checked out of [`DB_POOL`], returned on drop.
+struct PooledConn {
+    path: PathBuf,
+    conn: Option<Connection>,
+}
+
+impl std::ops::Deref for PooledConn {
+    type Target = Connection;
+
+    fn deref(&self) -> &Connection {
+        self.conn.as_ref().expect("connection is only taken in Drop")
+    }
+}
+
+impl Drop for PooledConn {
+    fn drop(&mut self) {
+        let Some(conn) = self.conn.take() else {
+            return;
+        };
+        let path = std::mem::take(&mut self.path);
+        if let Ok(mut pool) = db_pool().lock() {
+            let slot = pool.entry(path).or_default();
+            if slot.len() < MAX_POOLED_CONNS {
+                slot.push(conn);
+            }
+        }
+    }
+}
+
+/// Read-only connection to `path`, from the pool when one is free.
+fn cached_conn(path: &Path) -> Option<PooledConn> {
+    let pooled = db_pool()
+        .lock()
+        .ok()
+        .and_then(|mut pool| pool.get_mut(path).and_then(|slot| slot.pop()));
+    let conn = match pooled {
+        Some(conn) => conn,
+        None => Connection::open_with_flags(
+            path,
+            OpenFlags::SQLITE_OPEN_READ_ONLY | OpenFlags::SQLITE_OPEN_NO_MUTEX,
+        )
+        .ok()?,
+    };
+    Some(PooledConn {
+        path: path.to_path_buf(),
+        conn: Some(conn),
+    })
+}
